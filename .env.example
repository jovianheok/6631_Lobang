# Localhost environment template for the Lobang monorepo.
# Copy the values you need into:
# - lobang/apps/backend/.env
# - lobang/apps/frontend/.env.local
#
# Frontend variables use the NEXT_PUBLIC_ prefix because Next.js exposes them
# to the browser.

# Shared database access for backend and scraping pipeline
DATABASE_URL=postgresql://username:password@host:5432/postgres

# Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Local API URL used by the frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Backend CORS configuration for local frontend development
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Required if you want Google Places enrichment during scraping/submission
GOOGLE_PLACES_API_KEY=your_google_places_api_key
